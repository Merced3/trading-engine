# TRADING_MIGRATION_DATABASE_URL=postgresql://user:password@127.0.0.1:25432/trading?sslmode=require

TRADING_R2_ACCOUNT_ID=
TRADING_R2_ACCESS_KEY_ID=
TRADING_R2_SECRET_ACCESS_KEY=
TRADING_R2_BUCKET=trading-data
TRADING_R2_PREFIX=v1
